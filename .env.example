VITE_KSCAN_BACKEND_URL=https://kscan-app-1.onrender.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_META_APP_ID=
VITE_META_CLIENT_TOKEN=
VITE_MOCK_DAT=true
VITE_MOCK_DAT_SCENARIO=success
VITE_MOCK_DAT_DELAY_MS=600
VITE_MOCK_DAT_IMAGE_VARIANT=standard
VITE_MOCK_ANALYZE=true
VITE_MOCK_ANALYZE_DELAY_MS=900
VITE_MOCK_ANALYZE_ERROR=false
# Dev-only mobile bridge (Phase 17). Off by default. ws:// is localhost/LAN dev only.
VITE_ENABLE_MOBILE_BRIDGE=false
VITE_MOBILE_BRIDGE_WS_URL=ws://localhost:8787
# Phase 11 — simulator + DAT origin allowlist.
# VITE_ENABLE_SIMULATOR=true allows simulator features in a staging build (never set in production).
VITE_ENABLE_SIMULATOR=false
# Comma-separated allowlist of parent-frame origins permitted to answer capture requests.
# Leave empty in dev (own origin is always trusted). Set when the MRBD host origin is known.
VITE_DAT_PARENT_ORIGIN=

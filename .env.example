# K Scan Glasses Web App — Environment Variables
# .env is gitignored; this example file is safe to commit.

# ──────────────────────────────────────────────────────────────────────────
# REQUIRED FOR STAGING / PRODUCTION
# ──────────────────────────────────────────────────────────────────────────

# Backend URL for analyze requests. Must be HTTPS in production/staging.
# No trailing slash. Required for any backend call.
VITE_KSCAN_BACKEND_URL=https://kscan-app-1.onrender.com

# PRIVATE QA ONLY — explicit opt-in for live image analysis.
# /api/analyze is currently UNAUTHENTICATED and treated as an unverified
# release dependency. When this flag is not exactly "true", the production
# candidate is fail-closed: scans end with an honest LIVE DISABLED status
# instead of silently calling the live endpoint. The LOCAL QA simulator
# build defaults to honest mock regardless of this flag.
VITE_ENABLE_PRIVATE_LIVE_ANALYZE=false

# Supabase URL. Runtime window.__KSCAN_CONFIG__.SUPABASE_URL takes precedence.
# Leave empty locally unless testing live TextScan with the companion session bridge.
VITE_SUPABASE_URL=

# Supabase anon key. Runtime window.__KSCAN_CONFIG__.SUPABASE_ANON_KEY takes precedence.
# Never commit service-role keys or real bearer tokens.
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────────────────────────
# DEV / SIMULATOR ONLY — NEVER SET IN PRODUCTION
# ──────────────────────────────────────────────────────────────────────────

# Mock DAT capture. Only active when DEV=true or VITE_ENABLE_SIMULATOR=true.
# In production, this should be false so the app uses the real bridge path.
VITE_MOCK_DAT=true

# Mock DAT scenario (success, permission-denied, cancelled, timeout,
# invalid-response, malformed-image). Only honored when VITE_MOCK_DAT=true.
VITE_MOCK_DAT_SCENARIO=success

# Mock DAT delay (ms). Clamped 0–10000.
VITE_MOCK_DAT_DELAY_MS=600

# Mock image variant (standard, tiny, large). Only affects mock capture size.
VITE_MOCK_DAT_IMAGE_VARIANT=standard

# Mock analyze backend. Only active when DEV=true or VITE_ENABLE_SIMULATOR=true.
VITE_MOCK_ANALYZE=true

# Use real bridge capture (postMessage via bridgeState.js) instead of datBridge mock.
# Only active when explicitly set to true. Default remains mock/DAT fallback.
VITE_USE_REAL_BRIDGE=false

# Mock TextScan backend. VITE_MOCK_TEXTSCAN=true is for local simulator/dev only.
# Do not enable mock mode in production/staging unless intentionally testing mocks.
# Runtime window.__KSCAN_CONFIG__ takes precedence over Vite env for Supabase config/session.
VITE_MOCK_TEXTSCAN=false

# Mock analyze delay (ms). Clamped 0–5000.
VITE_MOCK_ANALYZE_DELAY_MS=900

# Force mock analyze error path (true/false). Only for testing failure UX.
VITE_MOCK_ANALYZE_ERROR=false

# ──────────────────────────────────────────────────────────────────────────
# STAGING-ONLY — ALLOWED IN STAGING PREVIEW, NEVER IN PRODUCTION
# ──────────────────────────────────────────────────────────────────────────

# Enable simulator features in a staging build (not production).
# Set to true if testers need the simulator badge + scenario overrides.
# Never set in production deploys.
VITE_ENABLE_SIMULATOR=false

# Comma-separated allowlist of parent-frame origins for DAT capture responses.
# Leave empty in dev (own origin is always trusted).
# Set to the real MRBD host origin when known from device testing.
VITE_DAT_PARENT_ORIGIN=

# ──────────────────────────────────────────────────────────────────────────
# MOBILE BRIDGE DEV — OFF BY DEFAULT
# ──────────────────────────────────────────────────────────────────────────

# Dev-only mobile bridge (Phase 17). ws:// is localhost/LAN dev only.
# Never use ws:// over the public internet. Off by default.
VITE_ENABLE_MOBILE_BRIDGE=false
VITE_MOBILE_BRIDGE_WS_URL=ws://localhost:8787

# ──────────────────────────────────────────────────────────────────────────
# BETA READINESS PLACEHOLDERS — SAFE TO LEAVE EMPTY IN PHASE 1
# ──────────────────────────────────────────────────────────────────────────

# Beta capture stub for real-glasses HUD testing. When true and DEV=true,
# a safe no-op beta stub simulates capture.success after ~1.5s for navigation
# testing without a real phone bridge. Never enable in production.
VITE_ENABLE_BETA_STUB=false

# Voice activation placeholder. When true, shows a disabled "Voice" setting row.
# No microphone access or recognition is implemented.
VITE_ENABLE_VOICE_PLACEHOLDER=false

# Mobile bridge placeholder status row. When true, shows "Mobile bridge: prepared"
# in Settings without enabling real bridge transport.
VITE_ENABLE_MOBILE_BRIDGE_PLACEHOLDER=false

# Connectivity status placeholder. When true, shows a "Connectivity: pending"
# status row in Settings for future Bluetooth/Wi-Fi display.
VITE_ENABLE_CONNECTIVITY_STATUS=false

# ──────────────────────────────────────────────────────────────────────────
# PUBLIC PREVIEW / HARDWARE TEST (Phase 30)
# ──────────────────────────────────────────────────────────────────────────
# For public HTTPS previews, set env vars in the hosting provider dashboard
# (e.g. Vercel Project → Settings → Environment Variables) — never commit
# real values to the repo.
#
# Preview modes:
#   Mock preview (default, safest): leave VITE_USE_REAL_BRIDGE=false and
#     VITE_MOCK_DAT=true. TextScan live requires Supabase config + session.
#   Bridge preview: VITE_USE_REAL_BRIDGE=true — Scan uses
#     bridgeState.requestCapture() postMessage contract.
#   Hardware test mode: open the app with ?mode=hardware (no env change) —
#     implies bridge mode and shows the HW TEST banner. Alpha labels stay on.
#
# Must remain UNSET/false in public preview: service-role keys (never
# anywhere in client), real tokens, VITE_MOCK_ANALYZE=true with live claims,
# VITE_ENABLE_BETA_STUB.

# Comma-separated allowlist of EXTRA origins accepted for bridge capture.*
# events (same origin is always allowed; '*' is ignored by design).
# Set only during Meta runtime / hardware testing, e.g. the runtime host origin.
VITE_BRIDGE_ALLOWED_ORIGINS=

# Comma-separated allowlist of EXTRA origins accepted for Supabase session
# postMessage events (kscan:supabase-session / kscan:supabase-token).
# Same origin is always allowed; '*' is ignored by design. Session messages
# additionally require event.source === window.parent.
# Set only once the real Meta runtime parent origin is known from device testing.
VITE_SESSION_ALLOWED_ORIGINS=

# Session persistence override. Sessions are NEVER persisted in production,
# previews, or hardware QA. Only honored in a dev server (DEV=true); any
# other environment ignores this flag.
VITE_SUPABASE_PERSIST_SESSION=false

# Reserved: target origin for outbound bridge postMessage once the real
# runtime origin is known from device testing. Not wired yet — outbound
# scaffold currently posts to parent with '*' (documented TODO in bridgeState.js).
VITE_BRIDGE_TARGET_ORIGIN=

# ──────────────────────────────────────────────────────────────────────────
# RESERVED / FUTURE
# ──────────────────────────────────────────────────────────────────────────

# Reserved for Meta app integration. Not used yet.
VITE_META_APP_ID=
VITE_META_CLIENT_TOKEN=
